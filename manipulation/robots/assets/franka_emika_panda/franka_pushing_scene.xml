<mujoco model="franka_panda_pushing">
  <include file="panda_slim.xml"/>

  <option timestep="0.002"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="135" elevation="-22"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.28 0.38 0.52" rgb2="0.03 0.04 0.06"
             width="512" height="3072"/>
    <texture type="2d" name="reach_ground" builtin="checker" mark="edge"
             rgb1="0.18 0.20 0.22" rgb2="0.10 0.11 0.12" markrgb="0.7 0.7 0.7"
             width="300" height="300"/>
    <material name="reach_ground" texture="reach_ground" texuniform="true" texrepeat="5 5"/>
    <material name="reach_target" rgba="0.12 0.90 0.20 0.90"/>
  </asset>

  <worldbody>
    <light pos="0.6 -0.4 1.7" dir="-0.2 0.25 -1" directional="true"/>
    <geom name="floor" type="plane" size="2 2 0.05" material="reach_ground"
          friction="1 0.01 0.001"/>

    <!-- Five visual-only benchmark waypoints. -->
    <site name="reach_waypoint_1" type="sphere" pos="0.45 -0.25 0.50" size="0.010" rgba="0.25 0.65 1.0 0.32"/>
    <site name="reach_waypoint_2" type="sphere" pos="0.50 -0.12 0.62" size="0.010" rgba="0.25 0.65 1.0 0.32"/>
    <site name="reach_waypoint_3" type="sphere" pos="0.55 0.00 0.50" size="0.010" rgba="0.25 0.65 1.0 0.32"/>
    <site name="reach_waypoint_4" type="sphere" pos="0.50 0.12 0.62" size="0.010" rgba="0.25 0.65 1.0 0.32"/>
    <site name="reach_waypoint_5" type="sphere" pos="0.45 0.25 0.50" size="0.010" rgba="0.25 0.65 1.0 0.32"/>

    <geom name="table" type="box" pos="0.55 0 0.32" size="0.38 0.42 0.025" rgba="0.37 0.39 0.42 1" friction="0.9 0.02 0.002"/>
    <body name="reach_target" pos="0.55 0 0.385">
      <freejoint name="reach_target_free"/>
      <geom name="reach_target_geom" type="box" size="0.032 0.032 0.040" mass="0.13" rgba="0.95 0.50 0.18 1" friction="0.8 0.015 0.002"/>
    </body>
    <body name="push_goal" mocap="true" pos="0.55 0.18 0.385">
      <geom name="push_goal_geom" type="box" size="0.032 0.032 0.040" rgba="0.16 0.90 0.28 0.32" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
